# ---- Browser (Vite) — public values only ----
# Supabase project URL and the publishable/anon key. Never put the service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Display timezone for due dates (all timestamps are stored in UTC)
VITE_DISPLAY_TIMEZONE=Asia/Kolkata

# ---- Server-only (scripts/provision-demo.mjs, Edge Functions) ----
# Used only by the local provisioning script. Keep out of the browser and out of git.
SUPABASE_SERVICE_ROLE_KEY=
# Password assigned to every synthetic demo account by the provisioning script.
DEMO_ACCOUNT_PASSWORD=

# ---- Optional integrations (Edge Function secrets) ----
# Leave empty to keep the integration in its honest "unconfigured" state.
OCR_PROVIDER=
OCR_API_KEY=
AI_PROVIDER=
AI_API_KEY=
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
